rules_version = '2';

// Regras do Cloud Firestore.
// Dados "sensíveis" do perfil (e-mail, celular, nascimento) ficam em /users/{uid},
// legíveis SOMENTE pelo dono. A API entrega esses dados a quem compartilha conversa/grupo.
// O que é listável por qualquer usuário autenticado fica em /publicProfiles/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- Perfil público (nome + foto) ----------
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'nameLower', 'photoUrl'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameLower is string
        && request.resource.data.photoUrl is string;
      allow delete: if false;
    }

    // ---------- Perfil completo (privado) ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.birthDate is string
        && request.resource.data.photoUrl is string
        && request.resource.data.createdAt is number;
      allow delete: if false;

      // Tokens de dispositivo: nunca públicos.
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- Conversas individuais ----------
    match /directConversations/{conversationId} {
      // 'resource == null' permite verificar se a conversa já existe sem vazar dados.
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'participantIds', 'createdAt'])
        && request.resource.data.type == 'direct'
        && request.resource.data.createdAt is number
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participantIds[1]));

      allow update, delete: if false;
    }

    // ---------- Grupos ----------
    match /groups/{groupId} {

      function validGroupFields(d) {
        return d.keys().hasOnly(
            ['name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
             'notificationPolicy', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && d.photoUrl is string
          && d.ownerId is string
          && d.memberLimit is int && d.memberLimit >= 2 && d.memberLimit <= 50
          && d.memberIds is list
          && d.memberIds.toSet().size() == d.memberIds.size()
          && d.ownerId in d.memberIds
          // LIMITE DE INTEGRANTES: validado no servidor do Firestore a cada escrita,
          // sobre o documento RESULTANTE. Escritas concorrentes não conseguem estourar.
          && d.memberIds.size() <= d.memberLimit
          && d.notificationPolicy in
             ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled']
          && d.createdAt is number
          && d.updatedAt is number;
      }

      function isGroupOwnerUpdate() {
        return resource.data.ownerId == request.auth.uid
          && validGroupFields(request.resource.data)
          && request.resource.data.memberIds.size() >= 2
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // Integrante (não proprietário) pode apenas sair do grupo.
      function isSelfLeave() {
        return request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds);
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && validGroupFields(request.resource.data)
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn() && (isGroupOwnerUpdate() || isSelfLeave());

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Log de idempotência das notificações: somente a API (Admin SDK) acessa.
    match /notificationLog/{logId} {
      allow read, write: if false;
    }
  }
}
