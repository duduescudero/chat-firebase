# Porta (a hospedagem normalmente define sozinha)
PORT=3000

# Credenciais do Firebase Admin SDK.
# CONFIGURE ESTES VALORES SOMENTE NAS VARIÁVEIS SECRETAS DA HOSPEDAGEM (ex.: Render).
# NUNCA coloque valores reais aqui nem no GitHub.
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com

# Opcional: token de acesso do Expo Push Service (reforça a segurança do envio)
EXPO_ACCESS_TOKEN=
